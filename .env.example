# Copy to backend/.env (backend) and frontend/.env (frontend). Never commit real values.

# --- Backend ---
DATABASE_URL=./seller_copilot.db
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Optional AI keys. Without them the app uses rule-based fallbacks.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.2
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- Frontend ---
VITE_API_BASE=http://localhost:8000
